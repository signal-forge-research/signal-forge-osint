# Censys Platform API v3 Personal Access Token (PAT)
CENSYS_PAT=

# Optional for paid/organization Censys accounts
CENSYS_ORG_ID=

BUILTWITH_API_KEY=
WHOISXML_API_KEY=
DNSDUMPSTER_API_KEY=

# Reserved until OpenCorporates access is approved
