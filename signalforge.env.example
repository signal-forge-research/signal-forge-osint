# Signal Forge OSINT credential template
#
# PUBLIC TEMPLATE ONLY: leave values blank in GitHub.
#
# On iPhone:
# 1. Copy this file.
# 2. Rename the private copy to: signalforge.env
# 3. Enter real credentials only in signalforge.env.
# 4. NEVER upload signalforge.env to GitHub.
#
# signalforge.env is excluded by .gitignore.

BRAVE_API_KEY=
SHODAN_API_KEY=
